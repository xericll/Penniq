# Copy to `.env` and fill in the values of the Supabase project (Project Settings → API).
# Without them the app still runs, but keeps everything on the device and never asks to sign in.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_…). It is meant to be public: row level security protects the data.
# Never put the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
